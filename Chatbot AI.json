    {
      "id": "code.execute-1786077970379",
      "data": {
        "label": "Code",
        "inputs": {
          "code": "// ==========================================\n// ManuMind AI - Chatbot Request Preprocessor\n// Purpose:\n// Extract only the user's message from the\n// webhook request before sending to Gemini.\n// ==========================================\n\n// Get all incoming items\nconst items = $input.all();\n\n// Process each request\nreturn items.map(item => {\n\n    const request = item.json.body;\n\n    return {\n        json: {\n            message: request.message.trim()\n        }\n    };\n\n});",
          "mode": "all",
          "path": "Chatbot",
          "isPublic": false,
          "language": "javascript",
          "placeholder": "Type your message...",
          "allowedRoles": "admin, staff",
          "jwtAlgorithm": "HS256",
          "responseMode": "Last Node",
          "roleClaimKey": "role",
          "sessionClaim": "sub",
          "authentication": "none",
          "requireRoleCheck": false,
          "requireButtonClick": false,
          "loadPreviousSession": true
        },
        "toolId": "code.execute",
