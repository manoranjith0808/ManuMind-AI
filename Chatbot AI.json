      "id": "code.execute-1786078387575",
      "data": {
        "label": "Code",
        "inputs": {
          "code": "// ==========================================\n// ManuMind AI - Chatbot Data Preprocessor\n// Purpose:\n// Filter MongoDB records and send only the\n// information required by the AI Chatbot.\n// ==========================================\n\n// Get incoming MongoDB response\nconst items = $input.all();\n\n// Get documents\nconst documents = items[0]?.json?.documents || [];\n\n// Extract only useful fields\nconst machineData = documents.map(doc => ({\n    timestamp: doc.timestamp,\n    machine_id: doc.machine_id,\n    production_line: doc.production_line,\n    status: doc.status,\n    cycle_time_sec: Number(doc.cycle_time_sec || 0),\n    units_produced: Number(doc.units_produced || 0),\n    defects: Number(doc.defects || 0),\n    downtime_min: Number(doc.downtime_min || 0),\n    oee_percent: Number(doc.oee_percent || 0),\n    availability_percent: Number(doc.availability_percent || 0),\n    performance_percent: Number(doc.performance_percent || 0),\n    quality_percent: Number(doc.quality_percent || 0),\n    maintenance_due_days: Number(doc.maintenance_due_days || 0),\n    shift: doc.shift\n}));\n\n// Return a single object for Gemini\nreturn [\n    {\n        json: {\n            machineData\n        }\n    }\n];",
          "limit": 200,
          "database": "machine",
          "language": "javascript",
          "collection": "dataset_1",
          "credentialId": "46898dea-3b9e-45e5-85f2-6d0b3cd67632"
        },
